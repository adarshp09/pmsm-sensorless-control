# Byte-compiled / cached files
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/

# Build artifacts
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.coverage_html/

# Lint / type-check caches
.ruff_cache/
.mypy_cache/
.dmypy.json

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Command Code local state (taste, sessions)
.commandcode/

# Local experiment output: results (JSON) are tracked so they survive a clone;
# generated plots and binary state dumps stay ignored.
experiments/**/*.npz
experiments/**/*.csv
experiments/**/output/**/*.png
# >2 MB result: too large to track (Phase 04c Step 0b); regenerate locally
experiments/output/04_flc_adaptation/flc.json
